# ==============================================================================
# .env.sample (환경변수 샘플 파일)
# 이 파일을 복사하여 .env 로 이름을 바꾼 뒤 실제 API 키를 입력해 사용하세요.
# ==============================================================================

# [필수] OpenAI API Key
OPENAI_API_KEY=""

# [필수] LangSmith 추적 설정 (LangChain 모니터링)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="study"

# [선택] Tavily 웹 검색 API Key (기업 최신 정보 및 뉴스 검색용)
TAVILY_API_KEY=""

# [선택] 데이터베이스 연결 URI (PostgreSQL / Supabase)
POSTGRES_URI=""

# [선택] 네이버 검색 API
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# [선택] 로그 설정
LOG_COLOR=false
PYTHONUTF8=1